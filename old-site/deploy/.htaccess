# ═══════════════════════════════════════════════════════════════════════
# cPanel deployment
#
# Upload the CONTENTS of `out/` (not the folder) into public_html, then place
# this file alongside them. Nothing else is required - there is no Node
# runtime, no build step and no process to keep alive.
#
# `trailingSlash: true` in next.config.ts means every route is emitted as
# `<route>/index.html`, which Apache resolves natively via DirectoryIndex.
# ═══════════════════════════════════════════════════════════════════════

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files and directories untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow the PHP form endpoint through before the 404 fallback.
  RewriteRule ^submit\.php$ - [L]

  # Anything else that is not a real file falls back to the 404 page.
  RewriteRule ^ /404.html [L]
</IfModule>

# ── Caching ────────────────────────────────────────────────────────────
# Hashed build assets are safe to cache forever. HTML must never be, or
# visitors keep seeing a stale page after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Compression ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── HTTPS ──────────────────────────────────────────────────────────────
# Enable once the SSL certificate is installed on brandupme.ae.
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
