# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
out/
.env*
!.env.example

# ── Client-confidential source material ────────────────────────────────
# The GitHub repo is PUBLIC. The BRD, executive summary and strategy PDFs
# are the client's internal documents and must never be published.
# The Next scaffold overwrote this rule once already - do not remove it.
docs/

# Generated by `pnpm seed:build`, and it contains the seeded admin account's
# password hash. This repo is PUBLIC - do not commit it. Regenerate instead:
#   pnpm seed:build && pnpm db:migrate && pnpm db:seed
/db/seed.sql

# Cloudflare local secrets and wrangler state. Never commit - .dev.vars holds
# API keys used by `wrangler dev`.
.dev.vars
.dev.vars.*
.wrangler/
.open-next/

# Local admin credentials produced by the seed. Never commit.
ADMIN-CREDENTIALS.local.txt
.seed-admin-pw.local
